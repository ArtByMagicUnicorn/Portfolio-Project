@page
@model Portfolio_Project.Pages.Admin.Projects.IndexModel

@{
    ViewData["Title"] = "Manage projects";
}

<section class="admin-header">
    <p class="eyebrow">Admin</p>
    <h1>Manage projects</h1>
    <p>Create, update, and remove portfolio projects.</p>
</section>

<p>
    <a asp-page="./Create" class="btn btn-primary">Create project</a>
    <a asp-page="/Admin/Index" class="btn btn-outline-secondary">Dashboard</a>
</p>

@if (Model.Projects.Count == 0)
{
    <p>No projects yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Preview</th>
                <th>Title</th>
                <th>Tech stack</th>
                <th>Featured</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in Model.Projects)
            {
                <tr>
                    <td class="admin-preview-cell">
                        @if (!string.IsNullOrWhiteSpace(project.ScreenshotUrl))
                        {
                            <img src="@project.ScreenshotUrl"
                                 alt="Screenshot of @project.Title"
                                 class="admin-project-thumbnail" />
                        }
                        else
                        {
                            <div class="admin-project-thumbnail admin-project-thumbnail-fallback">
                                <span>@project.Title</span>
                            </div>
                        }
                    </td>
                    <td>@project.Title</td>
                    <td>@project.TechStack</td>
                    <td>@(project.IsFeatured ? "Yes" : "No")</td>
                    <td>@project.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@project.Id">Edit</a>
                        |
                        <a asp-page="./Delete" asp-route-id="@project.Id">Delete</a>
                    </td>
                    <td>
                        <div class="status-list">
                            @if (project.IsFeatured)
                            {
                                <span class="status-pill status-pill-featured">Featured</span>
                            }

                            @if (string.IsNullOrWhiteSpace(project.ScreenshotUrl) ||
                                 string.IsNullOrWhiteSpace(project.GitHubUrl) ||
                                 string.IsNullOrWhiteSpace(project.DescriptionMarkdown))
                            {
                                <span class="status-pill status-pill-warning">Needs content</span>
                            }
                            else
                            {
                                <span class="status-pill status-pill-complete">Complete</span>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}