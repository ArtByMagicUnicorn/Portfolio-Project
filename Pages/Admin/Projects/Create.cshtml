@page
@model Portfolio_Project.Pages.Admin.Projects.CreateModel

@{
    ViewData["Title"] = "Create project";
}

<section class="admin-header">
    <p class="eyebrow">Admin</p>
    <h1>Create project</h1>
</section>

<form method="post" class="project-form">
    <div class="mb-3">
        <label asp-for="Project.Title" class="form-label"></label>
        <input asp-for="Project.Title" class="form-control" />
        <span asp-validation-for="Project.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Project.Slug" class="form-label"></label>
        <input asp-for="Project.Slug" class="form-control" />
        <span asp-validation-for="Project.Slug" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Project.Summary" class="form-label"></label>
        <textarea asp-for="Project.Summary" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Project.Summary" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Project.DescriptionMarkdown" class="form-label"></label>
        <textarea asp-for="Project.DescriptionMarkdown" class="form-control" rows="6"></textarea>
        <span asp-validation-for="Project.DescriptionMarkdown" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Project.TechStack" class="form-label"></label>
        <input asp-for="Project.TechStack" class="form-control" />
        <span asp-validation-for="Project.TechStack" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Project.GitHubUrl" class="form-label"></label>
        <input asp-for="Project.GitHubUrl" class="form-control" />
        <span asp-validation-for="Project.GitHubUrl" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Project.LiveUrl" class="form-label"></label>
        <input asp-for="Project.LiveUrl" class="form-control" />
        <span asp-validation-for="Project.LiveUrl" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Project.IsFeatured" class="form-check-input" />
        <label asp-for="Project.IsFeatured" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary">Save project</button>
    <a asp-page="/Projects/Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}