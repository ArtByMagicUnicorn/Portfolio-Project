@page
@model Portfolio_Project.Pages.AboutModel

@{
    ViewData["Title"] = "About";
}

<section class="about-hero about-hero-with-image">
    <div>
        <p class="eyebrow">About me</p>
        <h1>C# developer focused on practical web apps and cloud-ready solutions.</h1>
        <p>
            I am building my skills in C#, ASP.NET Core, and cloud development by creating
            practical projects that solve real problems and help me grow as a developer.
        </p>
    </div>

    <img src="/images/profile/profile.png"
         alt="Portrait of Martina"
         class="about-profile-image" />
</section>

<section class="about-grid">
    <article class="about-card">
        <h2>What I enjoy building</h2>
        <p>
            I like creating structured, useful web applications with clear data models,
            maintainable backend code, and interfaces that are pleasant to use.
        </p>
    </article>

    <article class="about-card">
        <h2>What I am learning</h2>
        <p>
            I am currently developing my cloud skills, with a focus on Azure, application
            hosting, storage, deployment workflows, and cloud-ready architecture.
        </p>
    </article>

    <article class="about-card">
        <h2>How I work</h2>
        <p>
            I care about understanding the code I write, building step by step, and making
            projects easier to maintain as they grow.
        </p>
    </article>
</section>
<section class="contact-section">
    <div>
        <p class="eyebrow">Contact</p>
        <h2>Want to connect?</h2>
        <p>
            I am always interested in learning, collaborating, and connecting with people
            working with C#, web development, and cloud solutions.
        </p>
    </div>

    <div class="contact-actions">
        <a href="https://github.com/ArtByMagicUnicorn"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-primary">
            GitHub
        </a>

        <a href="https://www.linkedin.com/in/martina-halldin-0ab056114/"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-outline-secondary">
            LinkedIn
        </a>

        <a href="mailto:martina.halldin@gmail.com"
           class="btn btn-outline-secondary">
            Email
        </a>
    </div>
</section>