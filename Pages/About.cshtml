@page
@model Portfolio_Project.Pages.AboutModel

@{
    ViewData["Title"] = "About";
}

<section class="about-hero about-hero-with-image">
    <div>
        <p class="eyebrow">About me</p>
        <h1>C# developer building practical web apps with cloud in mind.</h1>
        <p>
            I am a Cloud Developer student with a background in IT support and coordination.
            I use this portfolio to practice C#, ASP.NET Core, Razor Pages, EF Core, and Azure
            by building projects that are structured, useful, and gradually more cloud-ready.
        </p>
    </div>

    <img src="/images/martina-logo.png"
         alt="Martina Halldin - Cloud developer logo"
         class="about-profile-image" />
</section>

<section class="about-grid">
    <article class="about-card">
        <h2>What I enjoy building</h2>
        <p>
            I enjoy building structured web applications with clear data models,
            maintainable backend code, and interfaces that feel calm and useful.
        </p>
    </article>

    <article class="about-card">
        <h2>What I am learning</h2>
        <p>
            I am growing my skills in Azure, app hosting, storage, deployment workflows,
            authentication, testing, and cloud-ready architecture.
        </p>
    </article>

    <article class="about-card">
        <h2>How I work</h2>
        <p>
            I like to understand what I build, work step by step, and keep projects readable,
            maintainable, and grounded in real user needs.
        </p>
    </article>
</section>
<section class="contact-section">
    <div>
        <p class="eyebrow">Contact</p>
        <h2>Want to connect?</h2>
        <p>
            I am always happy to connect with people working with C#, web development,
            cloud solutions, or thoughtful technical problem solving.
        </p>
    </div>

    <div class="contact-actions">
        <a href="https://github.com/ArtByMagicUnicorn"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-primary">
            GitHub
        </a>

        <a href="https://www.linkedin.com/in/martina-halldin-0ab056114/"
           target="_blank"
           rel="noopener noreferrer"
           class="btn btn-outline-secondary">
            LinkedIn
        </a>

        <a href="mailto:martina.halldin@gmail.com"
           class="btn btn-outline-secondary">
            Email
        </a>
    </div>
</section>