@page
@model IndexModel

@{
    ViewData["Title"] = "Home";
}

<section class="home-hero">
    <div class="home-hero-content">
        <p class="eyebrow">Cloud & C# Developer Portfolio</p>
        <h1>Practical web apps built with C#, curiosity, and care.</h1>
        <p>
            I am building my skills in ASP.NET Core, Razor Pages, EF Core, and cloud development
            through practical projects with real structure, admin workflows, and deployment in mind.
        </p>

        <div class="hero-actions">
            <a asp-page="/Projects/Index" class="btn btn-primary">View projects</a>
            <a asp-page="/About" class="btn btn-outline-secondary">About me</a>
            <a href="https://github.com/ArtByMagicUnicorn" class="btn btn-outline-secondary" target="_blank" rel="noopener noreferrer">
                GitHub
            </a>
        </div>
    </div>
</section>

<section class="home-section">
    <div class="section-heading">
        <p class="eyebrow">Focus areas</p>
        <h2>What I work with</h2>
    </div>

    <div class="focus-grid">
        <article class="focus-card">
            <h3>C# & ASP.NET Core</h3>
            <p>
                Building structured web applications with Razor Pages, EF Core, validation,
                authentication, and clean backend flow.
            </p>
        </article>

        <article class="focus-card">
            <h3>Cloud Development</h3>
            <p>
                Learning Azure by connecting app hosting, storage, deployment, monitoring,
                and cloud-ready architecture to real projects.
            </p>
        </article>

        <article class="focus-card">
            <h3>Practical UX</h3>
            <p>
                Designing tools that are clear, useful, responsive, and pleasant to work with
                for both visitors and administrators.
            </p>
        </article>
    </div>
</section>

<section class="home-section">
    <div class="section-heading">
        <p class="eyebrow">Featured work</p>
        <h2>Selected projects</h2>
    </div>

    @if (Model.FeaturedProjects.Count == 0)
    {
        <p>No featured projects have been selected yet.</p>
    }
    else
    {
        <div class="featured-project-grid">
            @foreach (var project in Model.FeaturedProjects)
            {
                <article class="featured-project-card">
                    @if (!string.IsNullOrWhiteSpace(project.ScreenshotUrl))
                    {
                        <img src="@project.ScreenshotUrl"
                             alt="Screenshot of @project.Title"
                             class="featured-project-image" />
                    }

                    <div class="featured-project-content">
                        <h3>@project.Title</h3>
                        <p>@project.Summary</p>

                        @if (!string.IsNullOrWhiteSpace(project.TechStack))
                        {
                            <div class="tech-stack-list">
                                @foreach (var tech in project.TechStack.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="tech-chip">@tech</span>
                                }
                            </div>
                        }

                        <a asp-page="/Projects/Details"
                           asp-route-slug="@project.Slug"
                           class="btn btn-outline-primary">
                            View project
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</section>