@page
@model Portfolio_Project.Pages.Projects.IndexModel

@{
    ViewData["Title"] = "Projects";
}

<section class="projects-header">
    <p class="eyebrow">Portfolio</p>
    <h1>Projects</h1>
    <p>
        A selection of practical projects where I explore C#, ASP.NET Core, cloud development, and structured web application design.
    </p>

    <form method="get" class="project-search">
        <label asp-for="Search" class="form-label">Search projects</label>

        <div class="project-search-row">
            <input asp-for="Search"
                   class="form-control"
                   placeholder="Search by title, summary, or tech stack" />

            <button type="submit" class="btn btn-primary">Search</button>

            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
            }
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <p class="search-result-text">
            Showing results for <strong>@Model.Search</strong>
        </p>
    }
</section>

@if (!Model.Projects.Any())
{
    <section class="empty-state">
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <h2>No matching projects</h2>
            <p>
                No projects matched your search for <strong>@Model.Search</strong>.
            </p>
            <a asp-page="./Index" class="btn btn-outline-secondary">Clear search</a>
        }
        else
        {
            <h2>No projects yet</h2>
            <p>Once projects are added to the database, they will show up here.</p>
        }
    </section>
}
else
{
    <section class="project-grid">
        @foreach (var project in Model.Projects)
        {
            <article class="project-card">
                <div class="project-card-content">
                    @if (project.IsFeatured)
                    {
                        <span class="featured-label">Featured</span>
                    }

                    <h2>@project.Title</h2>
                    <p>@project.Summary</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(project.ScreenshotUrl))
                {
                    <img src="@project.ScreenshotUrl"
                         alt="Screenshot of @project.Title"
                         class="project-card-image" />
                }
                else
                {
                    <div class="project-card-image project-card-image-fallback">
                        <span>@project.Title</span>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(project.TechStack))
                {
                    <div class="tech-stack-list">
                        @foreach (var tech in project.TechStack.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                        {
                            <span class="tech-chip">@tech</span>
                        }
                    </div>
                }

                <div class="project-links">
                    <a asp-page="./Details" asp-route-slug="@project.Slug" class="btn btn-primary">
                        View project
                    </a>

                    @if (!string.IsNullOrWhiteSpace(project.GitHubUrl))
                    {
                        <a href="@project.GitHubUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-secondary">
                            GitHub
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(project.LiveUrl))
                    {
                        <a href="@project.LiveUrl"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn btn-outline-secondary">
                            Live site
                        </a>
                    }
                </div>
            </article>
        }
    </section>
}